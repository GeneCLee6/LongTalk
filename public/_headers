# Cache headers for the brand files (e4-t19, DEPLOY.md §9). Workers Static Assets reads this
# file and does not serve it. Everything else keeps the default (revalidate with the ETag every
# time). Not /assets/*, although Vite's file names carry a content hash: a chunk a stale tab still
# asks for after a deploy falls through to index.html (single-page-application), and that answer
# must not be cached for a year under the chunk's name.

# Brand files keep their names across deploys: a day, then revalidate
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=86400
/og-image.png
  Cache-Control: public, max-age=86400

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
