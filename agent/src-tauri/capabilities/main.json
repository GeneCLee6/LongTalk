{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The agent window: the app's own commands (build.rs) and listening to its two events, nothing else (f-remote-control-security.md §5.8)",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-agent-info",
    "allow-session-state",
    "allow-socket-connect",
    "allow-socket-send",
    "allow-confirm-join",
    "allow-set-sharing",
    "allow-leave-room",
    "allow-api-fetch",
    "allow-control-state",
    "allow-control-stop",
    "allow-control-mute",
    "allow-shared-screen"
  ]
}
