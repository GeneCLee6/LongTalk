{
  "name": "longtalk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/literals.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/budget.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/secrets.ts --dist",
    "brand": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/brand.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "test:ui": "playwright test -c playwright.local.config.ts",
    "lighthouse": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/lighthouse.ts"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "lighthouse": "13.6.0",
    "oxlint": "^1.90.0",
    "puppeteer-core": "25.16.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
