{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // One Worker serves the API, the Durable Objects and the React app's static assets (DEPLOY.md §1
  // says why this and not Pages + a separate Worker)
  "name": "longtalk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      // One object per room (ARCHITECTURE.md §2)
      { "name": "ROOM", "class_name": "RoomDO" },
      // One object for the whole deployment: the month's Realtime egress count (e11-t13)
      { "name": "USAGE", "class_name": "UsageDO" },
      // One object for the whole deployment: the telemetry counters behind /admin (e11-t03)
      { "name": "TELEMETRY", "class_name": "TelemetryDO" },
      // One object for the whole deployment: room-creation limits and the IP blocklist (e11-t05)
      { "name": "GUARD", "class_name": "GuardDO" }
    ]
  },
  // Accounts, passkeys, sessions and persistent rooms (I2, e1-t12, e1-t13). Tables in migrations/,
  // applied by the deploy workflow (`wrangler d1 migrations apply longtalk --remote`, DEPLOY.md §4)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "longtalk",
      "database_id": "603098a9-d685-4b7a-9911-55a629bd6882",
      "migrations_dir": "migrations"
    }
  ],
  // Workers Analytics Engine (e11-t03): every accepted telemetry event, for ad-hoc SQL. Off until
  // the owner enables Analytics Engine on the account (a deploy with the binding fails with code
  // 10089 before that); then uncomment this and the preview's line below (DEPLOY.md §8). Optional:
  // /admin reads TelemetryDO's counters, not this.
  // "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "longtalk_events" }],
  // The free plan only offers SQLite-backed Durable Objects. Migrations only ever add: never edit
  // or remove one that was deployed (DEPLOY.md §4)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["UsageDO"] },
    { "tag": "v3", "new_sqlite_classes": ["TelemetryDO"] },
    { "tag": "v4", "new_sqlite_classes": ["GuardDO"] }
  ],
  // The Realtime free-tier guard (e11-t13, DEPLOY.md §6): GB of SFU + TURN egress this calendar
  // month (UTC) after which cameras send low quality, and after which new video is refused.
  // Turnstile on room creation (e11-t05, DEPLOY.md §11): add "TURNSTILE_SITE_KEY": "<site key>"
  // here (public) once the owner has made the widget, and set the secret key with
  // `wrangler secret put TURNSTILE_SECRET_KEY`; Turnstile stays off until both exist.
  "vars": {
    "USAGE_LOW_QUALITY_GB": "800",
    "USAGE_AUDIO_ONLY_GB": "950"
  },
  // Pull request previews (DEPLOY.md §2): each PR deploys its own Worker, longtalk-pr-<number>,
  // with `wrangler deploy --name`, so it has its own Durable Object storage and never touches
  // production's. Bindings and vars are not inherited from the top level: repeat each one here.
  // Selected at build time with CLOUDFLARE_ENV=preview (the Vite plugin bakes it into dist/).
  "env": {
    "preview": {
      "name": "longtalk-preview",
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDO" },
          { "name": "USAGE", "class_name": "UsageDO" },
          { "name": "TELEMETRY", "class_name": "TelemetryDO" },
          { "name": "GUARD", "class_name": "GuardDO" }
        ]
      },
      // Every PR preview shares one database (accounts made by its e2e test delete themselves);
      // preview.yml applies the migrations before each deploy. Never production's
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "longtalk-preview",
          "database_id": "f50ae59d-26a1-425f-b39f-9910783281ee",
          "migrations_dir": "migrations"
        }
      ],
      // "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "longtalk_events_preview" }],
      // Turnstile's public test keys (DEPLOY.md §11): an invisible widget that always passes and a
      // secret that always validates, so every preview runs the whole room-creation flow. Never
      // real keys here: previews get no Turnstile secret of their own
      "vars": {
        "USAGE_LOW_QUALITY_GB": "800",
        "USAGE_AUDIO_ONLY_GB": "950",
        "TURNSTILE_SITE_KEY": "1x00000000000000000000BB",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      }
    }
  }
}
